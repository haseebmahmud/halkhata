{
  "name": "halkhata-desktop",
  "version": "0.1.0",
  "private": true,
  "author": "Haseeb Mahmud",
  "description": "Electron desktop shell for the Halkhata accounting app",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg --arm64",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@45.3.4": true
  },
  "build": {
    "appId": "com.halkhata.desktop",
    "productName": "Halkhata",
    "asar": true,
    "files": [
      "electron/main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "inst/shiny-app",
        "to": "shiny-app"
      },
      {
        "from": "electron/start-shiny.R",
        "to": "start-shiny.R"
      }
    ],
    "mac": {
      "target": "dmg",
      "identity": null,
      "category": "public.app-category.finance"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
